{
  "name": "imaginify-infrastructure",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "tsc",
    "build:backend": "cd ../backend && ./gradlew packageLambda packageEventHandler",
    "pretest": "npm run build:backend",
    "test": "jest --config jest.config.js",
    "synth": "npx cdk synth",
    "predeploy:beta": "npm run build:backend",
    "deploy:beta": "npx cdk deploy ImaginifyStack-beta",
    "predeploy:gamma": "npm run build:backend",
    "deploy:gamma": "npx cdk deploy ImaginifyStack-gamma",
    "predeploy:prod": "npm run build:backend",
    "deploy:prod": "npx cdk deploy ImaginifyStack-prod",
    "predeploy:all": "npm run build:backend",
    "deploy:all": "npx cdk deploy --all"
  },
  "dependencies": {
    "aws-cdk-lib": "^2.175.1",
    "constructs": "^10.4.2"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.5",
    "aws-cdk": "^2.1104.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "typescript": "^5.7.3"
  }
}
